# ---- Server config ----
PORT=5060
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5174

# How many proxy hops sit in front of the app. Wrong value = rate limiters key
# on a proxy's IP instead of the user's, so one busy edge locks everyone out.
#   2 (default) = AWS: client -> CloudFront -> ALB -> app
#   1           = a single load balancer
#   0           = local dev, nothing in front
# TRUST_PROXY=2

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/svastrino

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d

# ---- Seed admin (used by `npm run seed:admin`) ----
SEED_ADMIN_EMAIL=admin@svastrino.com
SEED_ADMIN_PASSWORD=changeme123

# ---- Google sign-in (only the Client ID is needed; GIS implicit flow) ----
# The SAME id must be exposed to the client as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ---- Email (SMTP) — verification + password-reset links ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password        # Gmail: use an App Password, not your login
# Where public enquiry-form submissions are emailed.
# Falls back to SEED_ADMIN_EMAIL when unset.
ENQUIRY_TO=enquiries@svastrino.com

SMTP_FROM="Svastrino <you@gmail.com>"

# Public URL of the CLIENT app — used to build links inside emails.
CLIENT_URL=http://localhost:5174

# ---- Payments: Cashfree ----
# Keys come from Merchant Dashboard → Developers → API Keys. Setting them is
# enough: Cashfree is used whenever both are present, and sandbox vs production
# is read off the secret's prefix (cfsk_ma_test_ / cfsk_ma_prod_), so going live
# is swapping in the production pair. With no keys you get the mock gateway for
# local dev. A production server refuses to sell on the mock OR on sandbox keys
# (test cards would buy real courses) until production keys are in. The webhook
# (POST /api/user/payments/webhook) is signed with the same secret key, so there
# is no separate webhook secret.
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# GATEWAY=cashfree            # optional: forces the choice
# CASHFREE_ENV=sandbox        # optional: only for keys without the usual prefix
# ALLOW_SANDBOX_PAYMENTS=true # production server only: sell on sandbox keys while
#                             # the site is not public yet. Remove before launch.

# ---- Media storage (admin video uploads) ----
# 'local' = disk (dev). Switch to 's3' and fill the AWS vars to serve from
# S3 + CloudFront (no other code changes — see src/config/uploads.js).
STORAGE=local
# S3_BUCKET=svastrino-media
# AWS_REGION=ap-south-1              # Mumbai
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# CDN_URL=https://dxxxx.cloudfront.net   # CloudFront domain in front of the bucket

# ---- Mindler psychometric assessment ----
# 'handoff' = student signs up on Mindler's white-label site themselves and an
# admin attaches the report. 'api' = we sign them in through Mindler's token
# login (below); the report is still attached by an admin.
MINDLER_MODE=handoff
MINDLER_STUDENT_URL=https://assessment.svastrino.com/
MINDLER_ACCESS_CODE=      # partner access code students use to sign up — real value in .env.local only
# MINDLER_SIGNUP_STEPS=Step one|Step two|Step three   # optional; overrides the default sign-up steps
#
# API mode (MINDLER_MODE=api) — Mindler's GRAFT token login, from their
# "API Integration and User Redirection Guide" (2026-09-22). Clicking "Take the
# test" asks Mindler for a login token and sends the student to
# <MINDLER_ORIGIN>/loginWithToken/<token>, signed up and signed in. Only the
# client code is required; the other two default to the guide's values.
# Finishing the test: each status read asks getAssessmentStatus (at most once a
# minute per student) and completes it when Mindler says so; "I've finished it"
# still works as before when Mindler says not yet. The report itself stays on
# the test site — the guide has no report endpoint.
# MINDLER_CLIENT_CODE=SVASTRINO
# MINDLER_ORIGIN=https://assessment.svastrino.com
# MINDLER_API_BASE=https://apis.mindler.com
# MINDLER_REPORT_PATH=/assessment/assessment-test-result/1   # where "See your report" lands
#
# The two how-to videos around the test (before the test, before the report)
# are links set in Admin → Settings, not here.

# ---- OpenAI ----
# Used for two things:
#   · Nirmaan scholarship — grades each reflective answer 0/1 (1 mark per
#     question). Without a key, answers fall back to a simple length heuristic
#     (dev only).
#   · Caption translation — builds an extra subtitle language from one the
#     session already has, keeping the original timings. This one has no
#     fallback: without a key it refuses, because a caption track that quietly
#     kept the source language would look like it had worked.
# gpt-4o-mini is cheap and capable for both; override the model if you like.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ---- Learning-flow test mode (DEV / QA ONLY — leave unset in production) ----
# The course is paced by a calendar: each task opens at the IST midnight after
# the one before it was finished, so walking a whole course takes as many real
# days as it has tasks. With this on, "the next midnight" becomes "right now" —
# finishing a task opens the next one at once, finishing a week opens the next
# week's video at once, the 5-plays-per-video limit is lifted, and the player
# lets you skip forward. The page shows a loud yellow "Test mode is on" banner
# while it is set. Order, one-open-task-at-a-time, phase payment and the
# one-year gate are all still enforced — only the waiting is removed.
# Turn it off by deleting the line (or setting 0) and RESTARTING the server.
# LEARN_TEST_MODE=1
