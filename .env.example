# ---- Server config ----
PORT=5060
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5174

# How many proxy hops sit in front of the app. Wrong value = rate limiters key
# on a proxy's IP instead of the user's, so one busy edge locks everyone out.
#   2 (default) = AWS: client -> CloudFront -> ALB -> app
#   1           = a single load balancer
#   0           = local dev, nothing in front
# TRUST_PROXY=2

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/svastrino

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d

# ---- Seed admin (used by `npm run seed:admin`) ----
SEED_ADMIN_EMAIL=admin@svastrino.com
SEED_ADMIN_PASSWORD=changeme123

# ---- Google sign-in (only the Client ID is needed; GIS implicit flow) ----
# The SAME id must be exposed to the client as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ---- Email (SMTP) — verification + password-reset links ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password        # Gmail: use an App Password, not your login
SMTP_FROM="Svastrino <you@gmail.com>"

# Public URL of the CLIENT app — used to build links inside emails.
CLIENT_URL=http://localhost:5174

# ---- Media storage (admin video uploads) ----
# 'local' = disk (dev). Switch to 's3' and fill the AWS vars to serve from
# S3 + CloudFront (no other code changes — see src/config/uploads.js).
STORAGE=local
# S3_BUCKET=svastrino-media
# AWS_REGION=ap-south-1              # Mumbai
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# CDN_URL=https://dxxxx.cloudfront.net   # CloudFront domain in front of the bucket

# ---- Mindler psychometric assessment ----
# 'handoff' = student takes the test on Mindler's white-label site and an admin
# attaches the report. Switch to 'api' only after Mindler provides real API
# credentials + endpoint docs (then implement them in assessment/mindler.js).
MINDLER_MODE=handoff
MINDLER_STUDENT_URL=https://svastrino.mindler.com/
MINDLER_ACCESS_CODE=      # partner access code students use to sign up — real value in .env.local only
# MINDLER_SIGNUP_STEPS=Step one|Step two|Step three   # optional; overrides the default sign-up steps
# MINDLER_API_BASE=
# MINDLER_API_KEY=        # never commit a real key — keep it in .env.local only

# ---- OpenAI (Nirmaan scholarship — AI grading of open-ended answers) ----
# Grades each reflective answer 0/1 (1 mark per question). gpt-4o-mini is cheap
# and capable for this; override the model if you like. Without a key, answers
# fall back to a simple length heuristic (dev only).
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
